# Environment for running the published backend image in the backoffice E2E tests.
#
# Every value is a throwaway test value. Nothing here is a real secret, and none of
# it must be reused outside a disposable E2E run. The database host is the service
# name of the compose that starts the image next to PostgreSQL.
#
# Left unset on purpose: object storage, Gemini, FCM and the internal service token.
# The backend starts without them; only the features that use them stay unavailable.

# A name of its own, so an E2E run is told apart from a developer's machine
# ("development") and from production.
ENVIRONMENT=e2e
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8080
SERVICE_NAME=backend

# The OpenTelemetry SDK reads this one, not the backend. Without a collector in the
# E2E run there is nothing to export to, so every signal becomes a no-op.
OTEL_SDK_DISABLED=true

# Database
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=db
DATABASE_USER=admin
DATABASE_PASSWORD=password

# JWT
JWT_SECRET_FIELD_WORKER=e2e-field-worker-secret
JWT_SECRET_ADMIN=e2e-admin-secret
JWT_SECRET_ANALYST=e2e-analyst-secret
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Superadmin created by the seed. The E2E tests log in as this user.
SEED_ADMIN_EMAIL=e2e-admin@tpp.com
SEED_ADMIN_PASSWORD=E2e-Admin-123!

# Mail is only logged, never sent.
SMTP_ENABLED=false

# Links built into the logged mails; the backoffice the E2E tests drive.
BACKOFFICE_DEEPLINK_BASE=http://localhost:3001

# Rate limiting
# Counted in the backend's own memory, so the E2E run needs no Redis. That is exact
# for the single container it starts.
RATE_LIMIT_REDIS_URL=memory://

# Every E2E request comes from one address and logs in as the same few users, far more
# often than a real caller, so each limit is high enough to never be reached. Both
# login limits matter: one counts the account, the other the address.
RATE_LIMIT_LOGIN_EMAIL=1000000/minute
RATE_LIMIT_LOGIN_IP=1000000/minute
RATE_LIMIT_TOKEN_IP=1000000/minute
RATE_LIMIT_REGISTER_IP=1000000/minute
RATE_LIMIT_MAIL_SENDING_EMAIL=1000000/minute
RATE_LIMIT_MAIL_SENDING_IP=1000000/minute
RATE_LIMIT_AI_USER=1000000/minute
