{
  "openapi": "3.1.0",
  "info": {
    "title": "Ingenieria para la Alimentación",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/establishments/{establishment_id}/nutrition-reports": {
      "get": {
        "tags": [
          "Nutrition Report V1"
        ],
        "summary": "List the saved monthly nutrition reports of an establishment",
        "description": "Returns the reports already generated for the establishment, a page at a time and ordered by month: newest first, or oldest first with sort_order=month_asc. Each item has only the basics; read the full report of a month with its own route. It never generates a report or calls the AI. Accessible by admins and analysts.",
        "operationId": "list_nutrition_reports_api_v1_establishments__establishment_id__nutrition_reports_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "establishment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Establishment Id"
            }
          },
          {
            "name": "sort_order",
            "in": "query",
            "required": false,
            "schema": {
              "$ref": "#/components/schemas/NutritionReportSortOrder",
              "default": "month_desc"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number, starting at 1.",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number, starting at 1."
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "description": "Results per page (max 100).",
              "default": 20,
              "title": "Page Size"
            },
            "description": "Results per page (max 100)."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PaginatedResponse_NutritionReportListItem_"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Establishment not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/establishments/{establishment_id}/nutrition-reports/{month}": {
      "get": {
        "tags": [
          "Nutrition Report V1"
        ],
        "summary": "Get the saved monthly nutrition report of an establishment",
        "description": "Returns the report already generated for a calendar month. It never generates a report or calls the AI: a month without a saved report answers 404. Accessible by admins and analysts.",
        "operationId": "get_nutrition_report_api_v1_establishments__establishment_id__nutrition_reports__month__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "establishment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Establishment Id"
            }
          },
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9]\\d{3}-(0[1-9]|1[0-2])$",
              "description": "Calendar month of the report, formatted as `YYYY-MM`.",
              "examples": [
                "2026-09"
              ],
              "title": "Month"
            },
            "description": "Calendar month of the report, formatted as `YYYY-MM`."
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NutritionReportResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Establishment not found, or no report for that month",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Nutrition Report V1"
        ],
        "summary": "Get or generate the monthly nutrition report of an establishment",
        "description": "Returns the nutrition report of the establishment for a calendar month. A report that was already generated is returned as saved, without calling the AI (200). Otherwise it is calculated, written up by the AI and saved (201). A month with no intakes is saved as no data, without calling the AI, and asking again calculates it again in case intakes were loaded since (200). If the AI fails, the calculated data is still saved and the summary is marked unavailable: asking again for that month writes only the summary again (200). The current month and future months are rejected (422), and a month whose foods have no known conversion to grams answers 409 and is not saved. Every call counts toward the AI quota. Accessible by admins and analysts.",
        "operationId": "put_nutrition_report_api_v1_establishments__establishment_id__nutrition_reports__month__put",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "establishment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Establishment Id"
            }
          },
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9]\\d{3}-(0[1-9]|1[0-2])$",
              "description": "Calendar month of the report, formatted as `YYYY-MM`.",
              "examples": [
                "2026-09"
              ],
              "title": "Month"
            },
            "description": "Calendar month of the report, formatted as `YYYY-MM`."
          }
        ],
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NutritionReportResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "200": {
            "description": "Report already saved, or its unavailable summary written again",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NutritionReportResponse"
                }
              }
            }
          },
          "404": {
            "description": "Establishment not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "None of the foods received in the month has a known conversion to grams",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "429": {
            "description": "AI quota exceeded; retry after Retry-After",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "504": {
            "description": "The request exceeded its time budget; ask again",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/establishments/{establishment_id}/nutrition-reports/{month}/pdf": {
      "get": {
        "tags": [
          "Nutrition Report V1"
        ],
        "summary": "Download a saved monthly nutrition report as a PDF",
        "description": "Returns an already generated report as a PDF file. It never generates a report or calls the AI: a month without a saved report answers 404, and a report whose AI summary is not available yet answers 409 until the summary is written again by requesting the report with the PUT route. A month without intakes is printed as it is. Accessible by admins and analysts.",
        "operationId": "download_nutrition_report_pdf_api_v1_establishments__establishment_id__nutrition_reports__month__pdf_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "establishment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Establishment Id"
            }
          },
          {
            "name": "month",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[1-9]\\d{3}-(0[1-9]|1[0-2])$",
              "description": "Calendar month of the report, formatted as `YYYY-MM`.",
              "examples": [
                "2026-09"
              ],
              "title": "Month"
            },
            "description": "Calendar month of the report, formatted as `YYYY-MM`."
          }
        ],
        "responses": {
          "200": {
            "description": "The report as a PDF file",
            "content": {
              "application/json": {
                "schema": {}
              },
              "application/pdf": {}
            }
          },
          "401": {
            "description": "Missing or invalid authentication token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Establishment not found, or no report for that month",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "The AI summary of the report is not available yet",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "NutritionReportSortOrder": {
        "type": "string",
        "enum": [
          "month_desc",
          "month_asc"
        ],
        "title": "NutritionReportSortOrder",
        "description": "Order in which the reports of an establishment are listed, by month."
      },
      "PaginatedResponse_NutritionReportListItem_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/NutritionReportListItem"
            },
            "type": "array",
            "title": "Items"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "total_pages": {
            "type": "integer",
            "title": "Total Pages"
          }
        },
        "type": "object",
        "required": [
          "items",
          "total",
          "page",
          "page_size",
          "total_pages"
        ],
        "title": "PaginatedResponse[NutritionReportListItem]"
      },
      "NutritionReportListItem": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "month": {
            "type": "string",
            "title": "Month",
            "description": "Calendar month of the report, formatted as `YYYY-MM`.",
            "examples": [
              "2026-09"
            ]
          },
          "has_data": {
            "type": "boolean",
            "title": "Has Data",
            "description": "False when there is no energy to judge in the month: no food was received, or only food without energy."
          },
          "summary_status": {
            "$ref": "#/components/schemas/SummaryStatus"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "month",
          "has_data",
          "summary_status",
          "created_at"
        ],
        "title": "NutritionReportListItem",
        "description": "The basics of a saved monthly report, as listed for an establishment."
      },
      "SummaryStatus": {
        "type": "string",
        "enum": [
          "generated",
          "unavailable",
          "not_applicable"
        ],
        "title": "SummaryStatus",
        "description": "What became of the AI-written summary of a report."
      },
      "ProblemDetail": {
        "type": "object",
        "description": "RFC 7807 problem details. `type` is the stable machine-readable identifier clients should branch on; `title` and `detail` are human-readable prose and may change without notice.",
        "properties": {
          "type": {
            "type": "string",
            "examples": [
              "/errors/survey-locked"
            ]
          },
          "title": {
            "type": "string"
          },
          "status": {
            "type": "integer"
          },
          "detail": {
            "type": "string"
          },
          "instance": {
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "detail",
          "instance"
        ],
        "additionalProperties": true
      },
      "NutritionReportResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "establishment_id": {
            "type": "string",
            "format": "uuid",
            "title": "Establishment Id"
          },
          "month": {
            "type": "string",
            "title": "Month",
            "description": "Calendar month of the report, formatted as `YYYY-MM`.",
            "examples": [
              "2026-09"
            ]
          },
          "has_data": {
            "type": "boolean",
            "title": "Has Data",
            "description": "False when there is no energy to judge in the month: no food was received, or only food without energy."
          },
          "reference_profile": {
            "type": "string",
            "title": "Reference Profile",
            "description": "Reference the intake was compared against, e.g. `nino_7_9`."
          },
          "analysis": {
            "$ref": "#/components/schemas/NutritionReportAnalysis"
          },
          "summary_status": {
            "$ref": "#/components/schemas/SummaryStatus"
          },
          "summary": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/NutritionReportSummary"
              },
              {
                "type": "null"
              }
            ],
            "description": "Summary written by the AI, as returned. Null unless generated."
          },
          "scope_note": {
            "type": "string",
            "title": "Scope Note",
            "description": "Fixed note on what the report assesses and what it does not.",
            "default": "Este informe evalúa el equilibrio nutricional de los alimentos que llegaron al comedor durante el mes. No conoce la dieta completa de los chicos, no indica si la cantidad alcanza y no reemplaza la evaluación de un nutricionista."
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "establishment_id",
          "month",
          "has_data",
          "reference_profile",
          "analysis",
          "summary_status",
          "created_at",
          "updated_at"
        ],
        "title": "NutritionReportResponse",
        "description": "A monthly nutrition report of an establishment."
      },
      "NutritionReportAnalysis": {
        "properties": {
          "energy_kcal": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Energy Kcal"
          },
          "mean_adequacy_percent": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Mean Adequacy Percent",
            "description": "Mean of the capped adequacies of the prioritized nutrients."
          },
          "nutrients": {
            "items": {
              "$ref": "#/components/schemas/ReportNutrient"
            },
            "type": "array",
            "title": "Nutrients"
          },
          "macros": {
            "items": {
              "$ref": "#/components/schemas/ReportMacro"
            },
            "type": "array",
            "title": "Macros"
          },
          "gapa_groups": {
            "items": {
              "$ref": "#/components/schemas/ReportGapaGroup"
            },
            "type": "array",
            "title": "Gapa Groups"
          },
          "limits": {
            "items": {
              "$ref": "#/components/schemas/ReportLimit"
            },
            "type": "array",
            "title": "Limits"
          },
          "top_sources": {
            "items": {
              "$ref": "#/components/schemas/ReportNutrientSources"
            },
            "type": "array",
            "title": "Top Sources"
          },
          "foods_without_conversion": {
            "items": {
              "$ref": "#/components/schemas/ReportFoodWithoutConversion"
            },
            "type": "array",
            "title": "Foods Without Conversion",
            "description": "Foods received in the month and left out of the calculation because they have no known conversion to grams."
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings",
            "description": "Data gaps found while calculating, such as foods left out."
          }
        },
        "type": "object",
        "title": "NutritionReportAnalysis",
        "description": "The nutritional balance of a month, as calculated when the report was made.\n\nShares and adequacies are percentages. It is stored with the report, so food\nnames are kept in it and the catalog is not read again. ``energy_kcal`` and\n``mean_adequacy_percent`` are null, and the lists empty, for a month with no\nintakes."
      },
      "ReportNutrient": {
        "properties": {
          "nutrient": {
            "$ref": "#/components/schemas/PrioritizedNutrient"
          },
          "amount_per_1000_kcal": {
            "type": "number",
            "title": "Amount Per 1000 Kcal",
            "description": "Amount of the nutrient per 1,000 kcal, in its own unit."
          },
          "reference_per_1000_kcal": {
            "type": "number",
            "title": "Reference Per 1000 Kcal",
            "description": "Amount 1,000 kcal of food should provide, in the nutrient's own unit."
          },
          "minimum_per_1000_kcal": {
            "type": "number",
            "title": "Minimum Per 1000 Kcal",
            "description": "Amount per 1,000 kcal below which the nutrient is at risk."
          },
          "adequacy_percent": {
            "type": "number",
            "title": "Adequacy Percent",
            "description": "Share of the reference covered, without a ceiling."
          },
          "adequacy_capped_percent": {
            "type": "number",
            "title": "Adequacy Capped Percent",
            "description": "Share of the reference covered, limited to 100."
          },
          "at_risk": {
            "type": "boolean",
            "title": "At Risk",
            "description": "Whether the intake is at risk of not covering the nutrient."
          }
        },
        "type": "object",
        "required": [
          "nutrient",
          "amount_per_1000_kcal",
          "reference_per_1000_kcal",
          "minimum_per_1000_kcal",
          "adequacy_percent",
          "adequacy_capped_percent",
          "at_risk"
        ],
        "title": "ReportNutrient",
        "description": "How much of a prioritized nutrient the month's intakes cover."
      },
      "PrioritizedNutrient": {
        "type": "string",
        "enum": [
          "calcio",
          "vitamina_a",
          "folato",
          "vitamina_b12",
          "vitamina_c",
          "hierro",
          "zinc"
        ],
        "title": "PrioritizedNutrient",
        "description": "The micronutrients that make up the composite adequacy indicator."
      },
      "ReportMacro": {
        "properties": {
          "macro": {
            "$ref": "#/components/schemas/Macronutrient"
          },
          "energy_share_percent": {
            "type": "number",
            "title": "Energy Share Percent"
          },
          "min_percent": {
            "type": "number",
            "title": "Min Percent"
          },
          "max_percent": {
            "type": "number",
            "title": "Max Percent"
          },
          "in_range": {
            "type": "boolean",
            "title": "In Range"
          }
        },
        "type": "object",
        "required": [
          "macro",
          "energy_share_percent",
          "min_percent",
          "max_percent",
          "in_range"
        ],
        "title": "ReportMacro",
        "description": "Share of the energy a macronutrient provides and the range it should hold."
      },
      "Macronutrient": {
        "type": "string",
        "enum": [
          "proteinas",
          "lipidos",
          "carbohidratos"
        ],
        "title": "Macronutrient",
        "description": "Macronutrients whose share of the energy is checked against a range."
      },
      "ReportGapaGroup": {
        "properties": {
          "group": {
            "$ref": "#/components/schemas/GapaGroup"
          },
          "energy_share_percent": {
            "type": "number",
            "title": "Energy Share Percent"
          },
          "missing": {
            "type": "boolean",
            "title": "Missing",
            "description": "Whether the group provided no energy at all in the month."
          }
        },
        "type": "object",
        "required": [
          "group",
          "energy_share_percent",
          "missing"
        ],
        "title": "ReportGapaGroup",
        "description": "Share of the energy that comes from one GAPA group."
      },
      "GapaGroup": {
        "type": "string",
        "enum": [
          "verduras_y_frutas",
          "legumbres_cereales_papa_pan_y_pastas",
          "leche_yogur_y_quesos",
          "carnes_y_huevos",
          "aceites_frutas_secas_y_semillas",
          "consumo_opcional"
        ],
        "title": "GapaGroup",
        "description": "The six GAPA food groups; values are the codes of ``gapa_food_categories``."
      },
      "ReportLimit": {
        "properties": {
          "code": {
            "type": "string",
            "title": "Code",
            "description": "Nutrient code in the food catalog."
          },
          "amount_per_1000_kcal": {
            "type": "number",
            "title": "Amount Per 1000 Kcal"
          }
        },
        "type": "object",
        "required": [
          "code",
          "amount_per_1000_kcal"
        ],
        "title": "ReportLimit",
        "description": "Intake of fiber, sodium, saturated fat or added sugar, shown as information."
      },
      "ReportNutrientSources": {
        "properties": {
          "nutrient": {
            "$ref": "#/components/schemas/PrioritizedNutrient"
          },
          "foods": {
            "items": {
              "$ref": "#/components/schemas/ReportFoodSource"
            },
            "type": "array",
            "title": "Foods"
          }
        },
        "type": "object",
        "required": [
          "nutrient",
          "foods"
        ],
        "title": "ReportNutrientSources",
        "description": "The foods that best cover a nutrient the intake is short of."
      },
      "ReportFoodSource": {
        "properties": {
          "food_id": {
            "type": "string",
            "format": "uuid",
            "title": "Food Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "amount_per_100_kcal": {
            "type": "number",
            "title": "Amount Per 100 Kcal"
          }
        },
        "type": "object",
        "required": [
          "food_id",
          "name",
          "amount_per_100_kcal"
        ],
        "title": "ReportFoodSource",
        "description": "A catalog food and how much of a nutrient it gives per 100 kcal."
      },
      "ReportFoodWithoutConversion": {
        "properties": {
          "food_id": {
            "type": "string",
            "format": "uuid",
            "title": "Food Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          }
        },
        "type": "object",
        "required": [
          "food_id",
          "name"
        ],
        "title": "ReportFoodWithoutConversion",
        "description": "A food received in the month that was left out for lacking a gram conversion."
      },
      "NutritionReportSummary": {
        "properties": {
          "overview": {
            "type": "string",
            "maxLength": 1500,
            "title": "Overview",
            "description": "The story of the month: how balanced the food was and which pattern stands out."
          },
          "at_risk_nutrients": {
            "items": {
              "type": "string",
              "maxLength": 1500
            },
            "type": "array",
            "maxItems": 7,
            "title": "At Risk Nutrients",
            "description": "One item per nutrient at risk, saying what falling short of it means and why it matters."
          },
          "macros": {
            "type": "string",
            "maxLength": 1500,
            "title": "Macros",
            "description": "What the split of the energy between proteins, lipids and carbohydrates suggests."
          },
          "gapa_groups": {
            "type": "string",
            "maxLength": 1500,
            "title": "Gapa Groups",
            "description": "What the weight of each food group says, and why a missing group matters."
          },
          "incorporate": {
            "type": "string",
            "maxLength": 1500,
            "title": "Incorporate",
            "description": "A line on which foods to add for the nutrients at risk."
          },
          "conclusion": {
            "type": "string",
            "maxLength": 1500,
            "title": "Conclusion",
            "description": "What deserves attention first and why, closing the report."
          },
          "limitations": {
            "items": {
              "type": "string",
              "maxLength": 1500
            },
            "type": "array",
            "title": "Limitations",
            "description": "One item per data gap to keep in mind when reading the report."
          }
        },
        "type": "object",
        "required": [
          "overview",
          "at_risk_nutrients",
          "macros",
          "gapa_groups",
          "incorporate",
          "conclusion",
          "limitations"
        ],
        "title": "NutritionReportSummary",
        "description": "The summary of a report, written by the AI in Spanish, one text per section.\n\nA section with nothing to say is an empty string or an empty list. The AI\nreturns this same shape."
      }
