{
  "title": "Backend - Logs",
  "uid": "backend-logs-overview",
  "tags": ["backend", "logs", "otel"],
  "schemaVersion": 39,
  "version": 2,
  "editable": true,
  "refresh": "1m",
  "time": { "from": "now-6h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "service",
        "label": "Service",
        "type": "custom",
        "query": "backend-prod,backend-dev",
        "includeAll": false,
        "multi": false,
        "options": [
          { "selected": true, "text": "backend-prod", "value": "backend-prod" },
          { "selected": false, "text": "backend-dev", "value": "backend-dev" }
        ],
        "current": { "text": "backend-prod", "value": "backend-prod" },
        "hide": 0
      },
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "query": "",
        "current": { "text": "", "value": "" },
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Lines / s",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": "grafanacloud-agusgermi-logs",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "mode": "fixed", "fixedColor": "purple" }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "area",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate({service_name=\"$service\"}[$__auto])) or vector(0)"
        }
      ]
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Info",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": "grafanacloud-agusgermi-logs",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "blue" }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service_name=\"$service\"} | detected_level=~\"(?i)info\" [$__range])) or vector(0)"
        }
      ]
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Warning",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": "grafanacloud-agusgermi-logs",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "orange" }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service_name=\"$service\"} | detected_level=~\"(?i)warn|warning\" [$__range])) or vector(0)"
        }
      ]
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Error / Critical",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": "grafanacloud-agusgermi-logs",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": { "mode": "fixed", "fixedColor": "red" }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum(count_over_time({service_name=\"$service\"} | detected_level=~\"(?i)error|critical|fatal\" [$__range])) or vector(0)"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Log volume by level",
      "gridPos": { "h": 8, "w": 16, "x": 0, "y": 4 },
      "datasource": "grafanacloud-agusgermi-logs",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": { "drawStyle": "bars", "stacking": { "mode": "normal" }, "fillOpacity": 60 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "error" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "warn" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "orange" } }] },
          { "matcher": { "id": "byName", "options": "info" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] }
        ]
      },
      "options": {
        "legend": { "displayMode": "list", "placement": "bottom" },
        "tooltip": { "mode": "multi", "sort": "desc" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (detected_level) (count_over_time({service_name=\"$service\"}[$__auto]))",
          "legendFormat": "{{detected_level}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "bargauge",
      "title": "Logs by source (logger)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 4 },
      "datasource": "grafanacloud-agusgermi-logs",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "color": { "mode": "continuous-GrYlRd" }
        },
        "overrides": []
      },
      "options": {
        "orientation": "horizontal",
        "displayMode": "gradient",
        "showUnfilled": true,
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false }
      },
      "targets": [
        {
          "refId": "A",
          "queryType": "instant",
          "expr": "sum by (scope_name) (count_over_time({service_name=\"$service\"}[$__range]))",
          "legendFormat": "{{scope_name}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "logs",
      "title": "Last 5 errors",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "datasource": "grafanacloud-agusgermi-logs",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "maxLines": 5,
          "expr": "{service_name=\"$service\"} | detected_level=~\"(?i)error|critical|fatal\""
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Last 5 warnings",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "datasource": "grafanacloud-agusgermi-logs",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "maxLines": 5,
          "expr": "{service_name=\"$service\"} | detected_level=~\"(?i)warn|warning\""
        }
      ]
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Live logs",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 20 },
      "datasource": "grafanacloud-agusgermi-logs",
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "{service_name=\"$service\"} |~ \"(?i)$search\""
        }
      ]
    }
  ]
}
