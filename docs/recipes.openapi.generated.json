  "components": {
    "securitySchemes": {
      "HTTPBearer": {
        "type": "http",
        "scheme": "bearer"
      }
    },
    "schemas": {
      "RecommendationInput": {
        "properties": {
          "establishment_id": {
            "type": "string",
            "format": "uuid",
            "title": "Establishment Id"
          },
          "children_count": {
            "type": "integer",
            "maximum": 10000.0,
            "minimum": 1.0,
            "title": "Children Count"
          },
          "meal_type": {
            "$ref": "#/components/schemas/MealType"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "establishment_id",
          "children_count",
          "meal_type"
        ],
        "title": "RecommendationInput",
        "description": "Fixed input for a recommendation request.",
        "examples": [
          {
            "children_count": 30,
            "establishment_id": "b45193cb-a2f1-427f-a4d8-adbb596561b0",
            "meal_type": "lunch"
          }
        ]
      },
      "MealType": {
        "type": "string",
        "enum": [
          "breakfast",
          "lunch",
          "snack",
          "dinner"
        ],
        "title": "MealType",
        "description": "Meal of the day a recipe is planned for."
      },
      "RecommendationResponse": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "establishment_id": {
            "type": "string",
            "format": "uuid",
            "title": "Establishment Id"
          },
          "children_count": {
            "type": "integer",
            "title": "Children Count"
          },
          "meal_type": {
            "$ref": "#/components/schemas/MealType"
          },
          "user_id": {
            "type": "string",
            "format": "uuid",
            "title": "User Id"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "prompt_version": {
            "type": "string",
            "title": "Prompt Version"
          },
          "proposals": {
            "items": {
              "$ref": "#/components/schemas/RecipeProposal"
            },
            "type": "array",
            "title": "Proposals"
          },
          "selection": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/RecipeSelectionResponse"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "establishment_id",
          "children_count",
          "meal_type",
          "user_id",
          "created_at",
          "prompt_version",
          "proposals",
          "selection"
        ],
        "title": "RecommendationResponse",
        "description": "A saved request, its proposals and its optional selection."
      },
      "RecipeProposal": {
        "properties": {
          "id": {
            "type": "string",
            "format": "uuid",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "portions": {
            "type": "integer",
            "title": "Portions"
          },
          "ingredients": {
            "items": {
              "$ref": "#/components/schemas/RecipeIngredient"
            },
            "type": "array",
            "title": "Ingredients"
          },
          "steps": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Steps"
          },
          "indicators": {
            "$ref": "#/components/schemas/NutritionIndicators"
          },
          "nutrient_adequacy_percent": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Nutrient Adequacy Percent"
          },
          "macronutrient_percent": {
            "additionalProperties": {
              "type": "number"
            },
            "type": "object",
            "title": "Macronutrient Percent"
          },
          "gapa_groups": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Gapa Groups"
          },
          "unmet_constraints": {
            "items": {
              "$ref": "#/components/schemas/UnmetConstraint"
            },
            "type": "array",
            "title": "Unmet Constraints"
          },
          "warnings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Warnings"
          },
          "target_energy_kcal": {
            "type": "number",
            "title": "Target Energy Kcal"
          },
          "energy_kcal": {
            "type": "number",
            "title": "Energy Kcal"
          },
          "cultural_identity": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CulturalIdentity"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "type": "object",
        "required": [
          "id",
          "name",
          "portions",
          "ingredients",
          "steps",
          "indicators",
          "nutrient_adequacy_percent",
          "macronutrient_percent",
          "gapa_groups",
          "unmet_constraints",
          "warnings",
          "target_energy_kcal",
          "energy_kcal"
        ],
        "title": "RecipeProposal",
        "description": "An immutable, calculated recipe proposal."
      },
      "RecipeIngredient": {
        "properties": {
          "food_id": {
            "type": "string",
            "format": "uuid",
            "title": "Food Id"
          },
          "name": {
            "type": "string",
            "title": "Name"
          },
          "grams": {
            "type": "number",
