  "paths": {
    "/api/v1/recipe-recommendations": {
      "post": {
        "tags": [
          "Recipes V1"
        ],
        "summary": "Generate up to 3 stock-backed recipe proposals",
        "description": "Generate and save proposals for the establishment, children count and meal type using current stock, the establishment characterization and recent choices. Requires an approved establishment relation for field workers and analysts; admins and superadmins may access any establishment. Quantities come from the nutrition optimizer; energy and nutritional shortfalls are returned explicitly. Aim for 2–3 proposals; a single valid proposal may be returned with warnings. Missing cultural inspiration does not block generation. Generation does not deduct stock.",
        "operationId": "generate_recommendations_api_v1_recipe_recommendations_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RecommendationInput"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RecommendationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Missing or invalid authentication token",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "403": {
            "description": "Insufficient permissions",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "404": {
            "description": "Establishment, request, proposal or food not found",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "409": {
            "description": "No usable stock, insufficient stock, or conflicting choice",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "429": {
            "description": "Caller rate limit (/errors/rate-limited) or provider usage limit (/errors/ai/quota-exhausted). Retry-After is present only when known.",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "503": {
            "description": "No eligible AI endpoint currently available (/errors/ai/unavailable)",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "502": {
            "description": "Model failed or returned invalid proposals",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "504": {
            "description": "Total generation time budget exceeded",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request payload",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected internal error",
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/ProblemDetail"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/establishments/{establishment_id}/recipe-recommendations": {
      "get": {
        "tags": [
          "Recipes V1"
        ],
        "summary": "List an establishment's recipe recommendation history",
        "description": "Return saved requests, newest first, with standard page and page_size pagination. With chosen_only=true, exclude unchosen requests and return only the chosen proposal in each request. Each item is a request containing its saved proposals (1–3), or one proposal after reuse. Requires establishment access (an approved relation for field workers and analysts). No model call or stock deduction occurs.",
        "operationId": "recommendation_history_api_v1_establishments__establishment_id__recipe_recommendations_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "establishment_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Establishment Id"
            }
          },
          {
            "name": "chosen_only",
            "in": "query",
            "required": false,
            "schema": {
              "type": "boolean",
              "default": false,
              "title": "Chosen Only"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "description": "Page number, starting at 1.",
              "default": 1,
              "title": "Page"
            },
            "description": "Page number, starting at 1."
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
