    "/api/v1/recipe-recommendations/{request_id}/proposals/{proposal_id}/choose": {
      "post": {
        "tags": [
          "Recipes V1"
        ],
        "summary": "Choose a recipe and deduct its ingredients",
        "description": "Atomically choose one proposal and create its kitchen food outflow. Current stock is checked at confirmation; a shortage rolls back the whole operation. Repeating the same choice returns 200 without another deduction; choosing a different proposal for that request returns 409. Requires an approved establishment relation for field workers and analysts; admins and superadmins may access any establishment.",
        "operationId": "choose_recipe_api_v1_recipe_recommendations__request_id__proposals__proposal_id__choose_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
