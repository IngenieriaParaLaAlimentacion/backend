ENVIRONMENT=development
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8080
SERVICE_NAME=backend

# Database
# Option 1 - Full URL (takes precedence)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Option 2 - Individual variables
DATABASE_HOST=postgres
DATABASE_NAME=db
DATABASE_PORT=5432
DATABASE_USER=admin
DATABASE_PASSWORD=password

# Database connection (optional; the values below are the defaults)
DATABASE_CONNECT_TIMEOUT_SECONDS=10
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10

# JWT
JWT_SECRET_FIELD_WORKER=your-super-secret-key-change-this-in-production
JWT_SECRET_ADMIN=super_secret_for_admins
JWT_SECRET_ANALYST=super_secret_for_analysts
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Superadmin seed
SEED_ADMIN_EMAIL="admin@dashboard.com"
SEED_ADMIN_PASSWORD="Admin123!"

# Email verification
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# Password recovery
PASSWORD_RECOVERY_TOKEN_EXPIRE_MINUTES=30

# SMTP
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_SENDER_EMAIL=no-reply@tpp.com

# Deeplinks
BACKOFFICE_DEEPLINK_BASE=http://localhost:3001
PUBLIC_BASE_URL=http://localhost:8000
PASSWORD_RECOVERY_PATH=/reset-password
EMAIL_VERIFICATION_PATH=/verify-email
INVITE_PATH=/invite


STORAGE_ENDPOINT_URL=https://<accountId>.r2.cloudflarestorage.com
STORAGE_BUCKET=tpp-dev
STORAGE_ACCESS_KEY_ID=...
STORAGE_SECRET_ACCESS_KEY=...
STORAGE_REGION=auto

# Receipt upload
RECEIPT_IMAGE_MAX_BYTES=10485760
RECEIPT_IMAGE_ALLOWED_TYPES=["image/jpeg","image/png","image/webp"]
RECEIPT_FOOD_MATCH_MIN_WORD_SIMILARITY=0.5
RECEIPT_FOOD_MATCH_MIN_SIMILARITY=0.22

# OpenRouter: configured models may incur charges against the account balance.
# Each JSON array accepts a primary model and an optional validated fallback.
OPENROUTER_API_KEY=
OPENROUTER_RECEIPT_MODELS=["google/gemini-2.5-flash-lite"]
OPENROUTER_RECIPE_MODELS=["google/gemini-2.5-flash-lite"]
OPENROUTER_REPORT_MODELS=["google/gemini-2.5-flash-lite"]
# Optional: leave empty to let OpenRouter choose the hosting provider.
OPENROUTER_ALLOWED_PROVIDERS=[]
OPENROUTER_MAX_OUTPUT_TOKENS=8192
OPENROUTER_REQUEST_TIMEOUT_SECONDS=25
OPENROUTER_COMPLETION_TIMEOUT_SECONDS=40
RECEIPT_GENERATION_TIMEOUT_SECONDS=60
RECIPE_GENERATION_TIMEOUT_SECONDS=90
REPORT_GENERATION_TIMEOUT_SECONDS=90

# Rate limiting (each limit is <count>/<period>: second, minute, hour, day)
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_SECONDS=0.2
RATE_LIMIT_REDIS_SOCKET_TIMEOUT_SECONDS=0.2
RATE_LIMIT_LOGIN_EMAIL=5/minute
RATE_LIMIT_LOGIN_IP=20/minute
RATE_LIMIT_MAIL_SENDING_EMAIL=3/hour
RATE_LIMIT_MAIL_SENDING_IP=10/hour
RATE_LIMIT_TOKEN_IP=20/minute
RATE_LIMIT_REGISTER_IP=5/hour
# Header where the platform proxy writes the caller's address
RATE_LIMIT_CLIENT_IP_HEADER=x-real-ip
# Secret shared with the backoffice so the backend trusts the user addresses it reports.
# Leave empty to disable.
INTERNAL_SERVICE_TOKEN=

# Shared per-user quota for recipe generation and receipt extraction
RATE_LIMIT_AI_USER=20/hour
