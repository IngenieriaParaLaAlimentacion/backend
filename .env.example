ENVIRONMENT=development
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8080

# Database
# Option 1 - Full URL (takes precedence)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Option 2 - Individual variables
DATABASE_HOST=postgres
DATABASE_NAME=db
DATABASE_PORT=5432
DATABASE_USER=admin
DATABASE_PASSWORD=password

# JWT
JWT_SECRET_USER=your-super-secret-key-change-this-in-production
JWT_SECRET_ADMIN=super_secret_for_admins
JWT_SECRET_PROFESSIONAL=super_secret_for_professionals
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7