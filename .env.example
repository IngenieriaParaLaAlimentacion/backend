ENVIRONMENT=development
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8080
SERVICE_NAME=backend-devs

# Database
# Option 1 - Full URL (takes precedence)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Option 2 - Individual variables
DATABASE_HOST=postgres
DATABASE_NAME=db
DATABASE_PORT=5432
DATABASE_USER=admin
DATABASE_PASSWORD=password

# JWT (generate with: openssl rand -hex 32)
JWT_SECRET_MANAGER=change-this-in-production
JWT_SECRET_ADMIN=super_secret_for_admins
JWT_SECRET_PROFESSIONAL=change-this-in-production
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Superadmin seed
SEED_ADMIN_EMAIL="admin@dashboard.com"
SEED_ADMIN_PASSWORD="Admin123!"

# Email verification
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# Password recovery
PASSWORD_RECOVERY_TOKEN_EXPIRE_MINUTES=30

# SMTP
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_SENDER_EMAIL=no-reply@tpp.com

# Deeplinks
BACKOFFICE_DEEPLINK_BASE=http://localhost:3001
PASSWORD_RECOVERY_PATH=/reset-password
EMAIL_VERIFICATION_PATH=/verify-email
INVITE_PATH=/invite

# Storage (Cloudflare R2)
STORAGE_ENDPOINT_URL=https://<accountId>.r2.cloudflarestorage.com
STORAGE_BUCKET=tpp-dev
STORAGE_ACCESS_KEY_ID=...
STORAGE_SECRET_ACCESS_KEY=...
STORAGE_REGION=auto

# Receipt upload
RECEIPT_IMAGE_MAX_BYTES=10485760
RECEIPT_IMAGE_ALLOWED_TYPES=["image/jpeg","image/png","image/webp"]
RECEIPT_FOOD_MATCH_MIN_WORD_SIMILARITY=0.5
RECEIPT_FOOD_MATCH_MIN_SIMILARITY=0.22

# Firebase Cloud Messaging (push notifications)
FCM_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----\n"
FCM_PROJECT_ID=your-project-id

# LLM
GEMINI_API_KEY=..
GEMINI_MODEL=gemini-3.6-flash
GEMINI_MAX_ATTEMPTS=3
GEMINI_RETRY_BACKOFF_INITIAL_SECONDS=1
GEMINI_RETRY_BACKOFF_MAX_SECONDS=8
GEMINI_REQUEST_TIMEOUT_SECONDS=120
# GEMINI_FALLBACK_MODEL=
GEMINI_FALLBACK_MAX_ATTEMPTS=2

# Rate limiting (each limit is <count>/<period>: second, minute, hour, day)
RATE_LIMIT_REDIS_URL=redis://localhost:6379/0
RATE_LIMIT_REDIS_CONNECT_TIMEOUT_SECONDS=0.2
RATE_LIMIT_REDIS_SOCKET_TIMEOUT_SECONDS=0.2
RATE_LIMIT_LOGIN_EMAIL=5/minute
RATE_LIMIT_LOGIN_IP=20/minute
RATE_LIMIT_MAIL_SENDING_EMAIL=3/hour
RATE_LIMIT_MAIL_SENDING_IP=10/hour
RATE_LIMIT_TOKEN_IP=20/minute
RATE_LIMIT_REGISTER_IP=5/hour
# Header where the platform proxy writes the caller's address
RATE_LIMIT_CLIENT_IP_HEADER=x-real-ip
# Secret shared with the backoffice so the backend trusts the user addresses it reports.
# Leave empty to disable.
INTERNAL_SERVICE_TOKEN=

# Observability (OpenTelemetry / Grafana)
OTEL_EXPORTER_OTLP_ENDPOINT=https://otlp-gateway-prod-sa-east-1.grafana.net/otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
OTEL_EXPORTER_OTLP_HEADERS=Authorization=Basic%20...==
OTEL_SEMCONV_STABILITY_OPT_IN=http