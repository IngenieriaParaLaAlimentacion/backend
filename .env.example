ENVIRONMENT=development
LOG_LEVEL=INFO

HOST=0.0.0.0
PORT=8080
SERVICE_NAME=backend

# Database
# Option 1 - Full URL (takes precedence)
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# Option 2 - Individual variables
DATABASE_HOST=postgres
DATABASE_NAME=db
DATABASE_PORT=5432
DATABASE_USER=admin
DATABASE_PASSWORD=password

# JWT
JWT_SECRET_FIELD_WORKER=your-super-secret-key-change-this-in-production
JWT_SECRET_ADMIN=super_secret_for_admins
JWT_SECRET_ANALYST=super_secret_for_analysts
JWT_ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# Superadmin seed
SEED_ADMIN_EMAIL="admin@dashboard.com"
SEED_ADMIN_PASSWORD="Admin123!"

# Email verification
EMAIL_VERIFICATION_TOKEN_EXPIRE_MINUTES=1440

# Password recovery
PASSWORD_RECOVERY_TOKEN_EXPIRE_MINUTES=30

# SMTP
SMTP_ENABLED=false
SMTP_HOST=localhost
SMTP_PORT=1025
# SMTP_USERNAME=
# SMTP_PASSWORD=
SMTP_USE_TLS=false
SMTP_SENDER_EMAIL=no-reply@tpp.com

# Deeplinks
APP_DEEPLINK_BASE=http://localhost:3000
BACKOFFICE_DEEPLINK_BASE=http://localhost:3001
PASSWORD_RECOVERY_PATH=/reset-password
EMAIL_VERIFICATION_PATH=/verify-email
INVITE_PATH=/invite
